{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/depeche_front/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://depeche-226.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://depeche-226.onrender.com/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
